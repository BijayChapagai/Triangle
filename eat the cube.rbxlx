					<string name="Name">FormatNumberAlt</string>
					<int64 name="SourceAssetId">7966215218</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">0243dfd7f47d0db6074fd57600008765</UniqueId>
