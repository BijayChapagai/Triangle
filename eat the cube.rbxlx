			<Item class="LocalScript" referent="RBX4E925851066C4DCAB8976A9CC1573DB8">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local MarketplaceService = game:GetService('MarketplaceService')
local Player = game:GetService('Players').LocalPlayer
	
local function Init()
	local StoreButtons = script.Parent.Store:GetChildren()
	
	for i, Button in StoreButtons do
		if not Button:IsA('GuiButton') then continue end
		
		Button.Activated:Connect(function()
			MarketplaceService:PromptProductPurchase(Player, Button:GetAttribute('ProductId'))
		end)
	end
end
Init()]]></ProtectedString>
