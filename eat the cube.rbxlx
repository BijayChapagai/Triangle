						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">RBX3e0994876629d20fc8f5705f71733170</UniqueId>
						<string name="ScriptGuid">{5AF78A6C-3BC8-430D-B173-CCC4D4BD18C7}</string>
						</Properties>
