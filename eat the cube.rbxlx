						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Zones</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">RBX7b2dfe9595f2bc16a13e97f6913795cd</UniqueId>
						<string name="ScriptGuid">{7E4A3CC4-B6B4-4CD8-9408-5CF1D7FC017A}</string>
