+	local scaled_boundary_plus_sigt0, scaled_boundary_plus_sigt1 =
+		diy_fp.mul128(
+			boundary_plus_sigt0, boundary_plus_sigt1,
+			ten_mk_sigt0, ten_mk_sigt1
+		)
