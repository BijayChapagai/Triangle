+}
+RARITY_WEIGHTS = [("Common", 62), ("Rare", 24), ("Epic", 10), ("Legendary", 3.5), ("Mythic", 0.5)]
+
+def pick_rarity():
+    total = sum(w for _, w in RARITY_WEIGHTS)
+    roll = random.random() * total
+    for key, w in RARITY_WEIGHTS:
+        roll -= w
+        if roll <= 0:
+            return key
+    return "Common"
+
+def attr_serialize(attrs):
+    out = struct.pack("<I", 1)
+    out += struct.pack("<I", len(attrs))
+    for name, val in attrs.items():
+        nb = name.encode()
+        out += struct.pack("<I", len(nb)) + nb + bytes([6]) + struct.pack("<d", float(val))
+    return base64.b64encode(out).decode()
+
+REGION = {"minX": -270, "maxX": 400, "minZ": -320, "maxZ": 320}
+
+BASE_TEXT = None
