+	{ name = "Astral",   rarity = "Legendary", mult = 1.0  },
+	{ name = "Voidling", rarity = "Mythic",    mult = 2.0  },
+}
+ProgressionConfig.PET_WEIGHTS = { Common = 50, Uncommon = 30, Rare = 14, Epic = 5, Legendary = 1, Mythic = 0.2 }
+ProgressionConfig.PET_MULT_CAP = 10
+
+function ProgressionConfig.petRoll()
+	local total = 0
+	for _, w in pairs(ProgressionConfig.PET_WEIGHTS) do total = total + w end
+	local roll = math.random() * total
