+def _find_part_block(text, name):
+    for m in re.finditer(r'<Item class="Part" referent="([^"]+)">.*?</Item>', text, re.S):
+        blk = m.group(0)
+        if ('<string name="Name">%s</string>' % name) in blk:
+            return blk, m.group(1)
+    return None, None
+
+def gen_food_cube(rarity_key, zone_id, center, radius, existing):
+    ref = gen_uid(existing)
+    g = RARITY_GEO[rarity_key]
+    block, oldref = _find_part_block(_base_text(), rarity_key)
+    if block is None:
+        # Fallback minimal block if asset missing
+                block = ('<Item class="Part" referent="%s"><Properties><bool name="Anchored">true</bool><token name="Shape">1</token><Vector3 name="size"><X>%s</X><Y>%s</Y><Z>%s</Z></Vector3><string name="Name">Food</string><SharedString name="Tags">%s</SharedString></Properties></Item>' % (ref, g["size"], g["size"], g["size"], FOOD_TAG))
+    else:
+        block = block.replace(oldref, ref)
+    sz = g["size"]
+    if zone_id and zone_id > 0 and center:
+        cx, _, cz = center
+        ang = random.random() * math.pi * 2
+        rr = math.sqrt(random.random()) * radius
+        x = cx + math.cos(ang) * rr
+        z = cz + math.sin(ang) * rr
+        y = 3.2
+    else:
+        x = random.uniform(REGION["minX"], REGION["maxX"])
+        z = random.uniform(REGION["minZ"], REGION["maxZ"])
+        y = 0.6
+    attr = attr_serialize({"Value": g["value"], "Zone": zone_id or 0})
+    block = re.sub(r'<bool name="Anchored">false</bool>', '<bool name="Anchored">true</bool>', block, count=1)
+    block = re.sub(r'<CoordinateFrame name="CFrame">.*?</CoordinateFrame>',
+                   '<CoordinateFrame name="CFrame"><X>%.3f</X><Y>%.3f</Y><Z>%.3f</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>' % (x, y, z), block, count=1)
+    block = re.sub(r'<Vector3 name="size">.*?</Vector3>',
+                   '<Vector3 name="size"><X>%s</X><Y>%s</Y><Z>%s</Z></Vector3>' % (sz, sz, sz), block, count=1)
+    block = re.sub(r'<BinaryString name="AttributesSerialize">.*?</BinaryString>',
+                   '<BinaryString name="AttributesSerialize">%s</BinaryString>' % attr, block, count=1)
+    block = re.sub(r'<string name="Name">[^<]*</string>', '<string name="Name">Food</string>', block, count=1)
+    return block
