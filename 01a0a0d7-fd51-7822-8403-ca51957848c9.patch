+	for i, v in ipairs(bnum) do
+		bnum[i], c =
+			bit32.band(c + bit32.lshift(v, local_shift), 0xFFFFFFF),
+			bit32.rshift(v, 28 - local_shift)
+	end
+	if c ~= 0 then
+		table.insert(bnum, c)
+	end
+end
