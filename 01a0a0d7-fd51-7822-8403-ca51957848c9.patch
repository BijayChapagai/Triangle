+function bignum.align(bnum: BigNum, other: BigNum): ()
+	local zero_digits = bnum.expt - other.expt
+	for i = 1, zero_digits do
+		table.insert(bnum, 1, 0)
+	end
+	bnum.expt -= math.max(zero_digits, 0)
+end
