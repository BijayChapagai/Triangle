+			rotateRight.Completed:Connect(function()
+				local revertTween = TS:Create(imageLabel, TweenInfo.new(sizeSpeed), { Size = originalSize, Rotation = 0 })
+				revertTween:Play()
+				revertTween.Completed:Connect(function()
+					isAnimating = false
+				end)
+			end)
+		end)
+	end)
+end
+
+while true do
+	startAnimation()
+	wait(5)
+end
+
