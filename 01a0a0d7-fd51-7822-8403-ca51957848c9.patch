+	FoodY = 0.6,                                            -- height of base-map food
+	ZoneFoodY = 3.2,
+	PetCubeTarget = 15,                                        -- height of zone food
+}
+
+-- // Pets
+ProgressionConfig.PETS = {
+	{ name = "Cubelet",  rarity = "Common",    mult = 0.05 },
+	{ name = "Blocky",   rarity = "Uncommon",  mult = 0.12 },
