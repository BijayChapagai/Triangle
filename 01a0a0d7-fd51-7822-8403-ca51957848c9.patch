+					<Content name="LinkedSource"><null></null></Content>
+					<ProtectedString name="Source"><![CDATA[local Manager = {}
+Manager.Profiles = {}
+
+--//Services
+local Players = game:GetService("Players")
+
+--//Variables
+local ProfileService = require(script.Parent.ProfileService)
+local Template = {
+	Cash = 0,
+	RedeemedCodes = {}
+}
+local ProfileStore = ProfileService.GetProfileStore("Yeah", Template)
+
+--if game:GetService("RunService"):IsStudio() then
+--	ProfileStore = ProfileStore.Mock
+--end
+
+Manager.PlayerAdded = function(player: Player)
+	local profile = ProfileStore:LoadProfileAsync("Player_"..player.UserId)
+	if profile ~= nil then
+		profile:AddUserId(player.UserId)
+		profile:Reconcile()
+		profile:ListenToRelease(function()
+			Manager.Profiles[player] = nil
+			player:Kick()
+		end)
+		
+		if player:IsDescendantOf(Players) == true then
+			Manager.Profiles[player] = profile
+			local leaderstats = Instance.new("Folder")
+			leaderstats.Name = "leaderstats"
+			leaderstats.Parent = player
+
+			local Cash = Instance.new("NumberValue")
+			Cash.Name = "Cash"
+			Cash.Value = profile.Data.Cash
+			Cash.Parent = leaderstats
+
+			local Size = Instance.new("NumberValue")
+			Size.Parent = leaderstats
+			Size.Name = "Size"
+			Size.Value = 0
+			
+			local Character = player.Character or player.CharacterAdded:Wait()
+			
+			Character.PlayerDisplay.PlayerName.Text = `@ {player.Name}`
+			Character.PlayerDisplay.PlayerSize.Text = `Size: {Size.Value}`
+			
+			Size.Changed:Connect(function()
+				player.Character.PlayerDisplay.PlayerSize.Text = `Size: {player:FindFirstChild("leaderstats"):FindFirstChild("Size").Value}`
+			end)
+			
+		else
+			profile:Release()
+		end
+	else
+		
+		player:Kick()
+	end
+end
+
+Manager.PlayerRemoving = function(player: Player)
+	local profile = Manager.Profiles[player]
+	if profile ~= nil then
+		profile:Release()
+	end
+end
+
+return Manager]]></ProtectedString>
