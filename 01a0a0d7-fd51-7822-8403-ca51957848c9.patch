+						<ProtectedString name="Source"><![CDATA[--// Pets inventory frame (matches existing UI style)
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Players = game:GetService("Players")
+local Player = Players.LocalPlayer
+local PG = Player:WaitForChild("PlayerGui")
+local Events = ReplicatedStorage:WaitForChild("Events")
+
+local frame = script.Parent
+local list = frame:WaitForChild("List")
+local template = Instance.new("TextButton")
+template.Size = UDim2.new(1, 0, 0, 60)
+template.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
+template.BorderSizePixel = 0
+template.AutoButtonColor = false
+template.Font = Enum.Font.Gotham
+template.TextSize = 16
+template.TextColor3 = Color3.fromRGB(255, 255, 255)
+template.TextWrapped = true
+template.TextXAlignment = Enum.TextXAlignment.Left
+
+local pets = {}
+
+local function rebuild()
+	for _, c in ipairs(list:GetChildren()) do
+		if c:IsA("TextButton") then c:Destroy() end
+	end
+	table.sort(pets, function(a, b) return (a.mult or 0) > (b.mult or 0) end)
+	for _, p in ipairs(pets) do
+		local b = template:Clone()
+		local equipTxt = p.equipped and "[EQUIPPED]" or "[tap to equip]"
+		b.Text = ("  %s  (%s)\n  +%.0f%% size   %s"):format(p.name, p.rarity, (p.mult or 0) * 100, equipTxt)
+		b.BackgroundColor3 = p.equipped and Color3.fromRGB(60, 90, 60) or Color3.fromRGB(40, 40, 60)
+		b.Parent = list
+		b.Activated:Connect(function()
+			Events.EquipPet:FireServer(p.id)
+		end)
+	end
+end
+
+Events.PetList.OnClientEvent:Connect(function(list_pets)
+	pets = list_pets or {}
+	rebuild()
+end)
+
+Events.EquipPet.OnClientEvent:Connect(function() end) -- server re-sends PetList
+rebuild()
+]]></ProtectedString>
